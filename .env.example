# EcoTwin AI — Environment Configuration
# Copy this file to .env in the project root if you want to override defaults.

DATABASE_URL=sqlite:///data/ecotwin.db
SECRET_KEY=change-this-to-a-random-secret-key
# Set true when HTTPS terminates in front of the backend.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=false
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_CITY=Hyderabad
DEFAULT_STATE=Telangana
REQUIRE_WORKSPACE_ID=true
# Optional API token for non-user integrations.
API_TOKEN=

CV_MODEL_PATH=computer_vision/models/yolox_tiny.onnx
CV_CONFIDENCE_THRESHOLD=0.35
CV_MAX_IMAGE_SIZE_MB=10
CV_TEMP_IMAGE_DIR=data/temporary_images
MAX_IMAGE_DIMENSION=1920
